fof(ax,axiom, (~ (~ vP1944_NL_0 & vP1944_NL_1) |  ((vP1944_NUK_0 |  vP1944_NUK_1) |  ((vP1944_N_0 |  vP1944_N_1) |  (vP1944__AUTOR_JR_0 |  vP1944__AUTOR_JR_1))))).

fof(ax,conjecture, (~ (~ vP1944_NL_1 & vP1944_NL_2) |  ((vP1944_NUK_1 |  vP1944_NUK_2) |  ((vP1944_N_1 |  vP1944_N_2) |  (vP1944__AUTOR_JR_1 |  vP1944__AUTOR_JR_2)))) & 
$true) .
