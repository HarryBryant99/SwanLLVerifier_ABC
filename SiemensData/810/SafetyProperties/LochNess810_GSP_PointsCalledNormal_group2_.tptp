fof(ax,axiom, (~ (~ vP1946_NL_0 & vP1946_NL_1) |  ((vP1946A_NUK_0 |  vP1946A_NUK_1) |  ((vP1946_N_0 |  vP1946_N_1) |  (vP1946__AUTOR_JR_0 |  vP1946__AUTOR_JR_1))))).

