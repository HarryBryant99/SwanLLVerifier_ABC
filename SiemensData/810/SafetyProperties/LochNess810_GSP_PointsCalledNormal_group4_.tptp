fof(ax,axiom, (~ (~ vP1947_NL_0 & vP1947_NL_1) |  ((vP1947_NUK_0 |  vP1947_NUK_1) |  ((vP1947_N_0 |  vP1947_N_1) |  (vP1947__AUTOR_JR_0 |  vP1947__AUTOR_JR_1))))).

fof(ax,conjecture, (~ (~ vP1947_NL_1 & vP1947_NL_2) |  ((vP1947_NUK_1 |  vP1947_NUK_2) |  ((vP1947_N_1 |  vP1947_N_2) |  (vP1947__AUTOR_JR_1 |  vP1947__AUTOR_JR_2)))) & 
$true) .
