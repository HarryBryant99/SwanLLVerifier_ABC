fof(ax,axiom, (~ (~ vP1948_NL_0 & vP1948_NL_1) |  ((vP1948_NUK_0 |  vP1948_NUK_1) |  ((vP1948_N_0 |  vP1948_N_1) |  (vP1948__AUTOR_JR_0 |  vP1948__AUTOR_JR_1))))).

fof(ax,conjecture, (~ (~ vP1948_NL_1 & vP1948_NL_2) |  ((vP1948_NUK_1 |  vP1948_NUK_2) |  ((vP1948_N_1 |  vP1948_N_2) |  (vP1948__AUTOR_JR_1 |  vP1948__AUTOR_JR_2)))) & 
$true) .
