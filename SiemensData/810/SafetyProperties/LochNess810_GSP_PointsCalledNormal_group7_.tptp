fof(ax,axiom, (~ (~ vP1952_NL_0 & vP1952_NL_1) |  ((vP1952_NUK_0 |  vP1952_NUK_1) |  ((vP1952_N_0 |  vP1952_N_1) |  (vP1952__AUTOR_JR_0 |  vP1952__AUTOR_JR_1))))).

fof(ax,conjecture, (~ (~ vP1952_NL_1 & vP1952_NL_2) |  ((vP1952_NUK_1 |  vP1952_NUK_2) |  ((vP1952_N_1 |  vP1952_N_2) |  (vP1952__AUTOR_JR_1 |  vP1952__AUTOR_JR_2)))) & 
$true) .
