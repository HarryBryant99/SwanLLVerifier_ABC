fof(ax,axiom, (~ (~ vP1954_NL_0 & vP1954_NL_1) |  ((vP1954_NUK_0 |  vP1954_NUK_1) |  ((vP1954_N_0 |  vP1954_N_1) |  (vP1954__AUTOR_JR_0 |  vP1954__AUTOR_JR_1))))).

