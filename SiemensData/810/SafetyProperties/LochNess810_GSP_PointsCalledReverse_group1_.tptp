fof(ax,axiom, (~ (~ vP1945_RL_0 & vP1945_RL_1) |  ((vP1945_RUK_0 |  vP1945_RUK_1) |  ((vP1945_R_0 |  vP1945_R_1) |  (vP1945__AUTOR_JR_0 |  vP1945__AUTOR_JR_1))))).

