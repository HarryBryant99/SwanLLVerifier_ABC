fof(ax,axiom, (~ (~ vP1952_RL_0 & vP1952_RL_1) |  ((vP1952_RUK_0 |  vP1952_RUK_1) |  ((vP1952_R_0 |  vP1952_R_1) |  (vP1952__AUTOR_JR_0 |  vP1952__AUTOR_JR_1))))).

fof(ax,conjecture, (~ (~ vP1952_RL_1 & vP1952_RL_2) |  ((vP1952_RUK_1 |  vP1952_RUK_2) |  ((vP1952_R_1 |  vP1952_R_2) |  (vP1952__AUTOR_JR_1 |  vP1952__AUTOR_JR_2)))) & 
$true) .
