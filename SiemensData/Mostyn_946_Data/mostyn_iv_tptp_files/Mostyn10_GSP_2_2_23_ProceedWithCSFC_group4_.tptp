fof(ax,axiom, ((~ (~ vS6041_DGE_0 & vS6041_DGE_1) |  ~ (vLOS2_JS_0 & vLOS2_JR_0)) & (~ (~ vS6041__SUB_GE_0 & vS6041__SUB_GE_1) |  ~ (vLOS2_JS_0 & vLOS2_JR_0)))).

fof(ax,conjecture, ((~ (~ vS6041_DGE_1 & vS6041_DGE_2) |  ~ (vLOS2_JS_1 & vLOS2_JR_1)) & (~ (~ vS6041__SUB_GE_1 & vS6041__SUB_GE_2) |  ~ (vLOS2_JS_1 & vLOS2_JR_1))) & 
$true) .
